#!/usr/bin/env python3
import json, os, sys

WORDS = "we agreed to ship the billing report on Friday and Sam checks the numbers".split()
args = sys.argv[1:]
for i, a in enumerate(args):
    if a != "-f":
        continue
    path = args[i + 1]
    end = (os.path.getsize(path) - 44) // 32
    start = max(0, end - 1000)
    tokens = [{"text": "[_BEG_]", "offsets": {"from": start, "to": start}}]
    tokens += [{"text": " " + w, "offsets": {"from": start + k * 60, "to": start + k * 60 + 50}} for k, w in enumerate(WORDS)]
    seg = {"offsets": {"from": start, "to": end}, "text": " " + " ".join(WORDS), "tokens": tokens}
    with open(path + ".json", "w") as f:
        json.dump({"transcription": [seg]}, f)
